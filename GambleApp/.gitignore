# --- Env / secrets ---
.env
.env.*             # keep .env.example tracked
!.env.example

# --- OS junk ---
.DS_Store
Thumbs.db

# --- Editors ---
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
.idea/
*.iml

# --- Node / logs / caches ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
*.log
.cache/
*.tsbuildinfo

# --- Expo / EAS ---
.expo/
.eas/local-build/          # local EAS build cache
dist/                      # expo export output (your CI uses this)
web-build/                 # legacy expo web output
# .expo-shared/            # usually DO NOT ignore; keep tracked if it exists

# --- Testing / reports ---
coverage/
reports/
jest-results.json
junit.xml

# --- Android (choose ONE of the two blocks) ---
# If you DO NOT commit android/ (managed workflow or CI prebuild):
android/

# If you DO commit android/ (bare or customized native code), comment the line above
# and use the per-folder ignores below instead:
# android/.gradle/
# android/build/
# android/app/build/
# android/local.properties
# *.keystore
# **/debug.keystore
# captures/

# --- iOS (choose ONE of the two blocks) ---
# If you DO NOT commit ios/ (managed workflow or CI prebuild):
ios/

# If you DO commit ios/ (bare or customized native code), comment the line above
# and use the per-folder ignores below instead:
# ios/build/
# ios/DerivedData/
# ios/Pods/
# *.pbxuser
# !default.pbxuser
# *.mode1v3
# *.mode2v3
# *.perspectivev3
# !default.mode1v3
# !default.mode2v3
# !default.perspectivev3
# xcuserdata/
# *.xccheckout
# *.xcscmblueprint

# --- Build artifacts you might produce locally ---
*.apk
*.aab
*.ipa


expo-env.d.ts

